# Vercelの環境変数として設定する値の例
# 本番では Vercel Dashboard > Project > Settings > Environment Variables から登録
# ローカル開発時は `.env.local` にコピーして値を埋める（コミット厳禁）

# ----- アプリ認証 -----
# スタッフ用ログインパスワード
APP_PASSWORD=change-me-to-strong-password

# Cookie署名用のランダム文字列（最低16文字、推奨64文字以上）
# 生成例: openssl rand -hex 32
SESSION_SECRET=change-me-to-random-64-char-hex-string

# ----- GAS API 連携 -----
# GASウェブアプリのデプロイURL（末尾 /exec）
GAS_URL=https://script.google.com/macros/s/AKfycbxxxxxxxxx/exec

# GAS側のスクリプトプロパティ API_SECRET と同じ値
GAS_API_TOKEN=change-me-to-match-gas-script-property
